OPENAI_API_KEY=replace-me
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini
# Optional comma-separated selectable models. Requires backend --enable-model-picker.
# OPENAI_MODEL is always included first.
# OPENAI_MODELS=gpt-4.1-mini,gpt-4.1,gpt-4o-mini
# YOLO mode (skip validation harness) is enabled by default; pass --disable-yolo-mode to turn off.
HOST=0.0.0.0
PORT=8787
REQUEST_TIMEOUT_MS=120000
OPENAI_CONTEXT_WINDOW=128000
# Compress run context when cumulative usage reaches this fraction (0 disables, default 0.9)
OPENAI_CONTEXT_COMPRESS_THRESHOLD=0.9
MAX_RUNS=100
MAX_ACTIVE_RUNS=5
GENERATION_RATE_LIMIT_WINDOW_MS=60000
GENERATION_RATE_LIMIT_MAX=10
# CORS_ORIGIN=https://app.example
TRUST_PROXY=false

# --- Accounts and hosting (SQLite) ---
# Path to the SQLite database file. Parent directory is created automatically.
# In Docker/Kubernetes, mount a persistent volume at /app/data (or match this path).
DATABASE_PATH=./data/prism0.db
# Public origin for verification email links (use HTTPS in production).
APP_BASE_URL=http://localhost:8787
# Session cookie lifetime in milliseconds (default 7 days).
SESSION_TTL_MS=604800000
# Dev/tests only: return email verification tokens in register/resend API JSON.
# Ignored when NODE_ENV=production.
AUTH_EXPOSE_VERIFICATION_TOKEN=false
# Auth endpoint rate limits (register, login, resend, verify).
AUTH_RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX=20
# Lock out a username after this many failed logins within the lockout window.
AUTH_LOGIN_MAX_FAILURES=5
AUTH_LOGIN_LOCKOUT_MS=900000
# Enable email verification, change-email, and related UI/API features (default false).
# AUTH_EMAIL_ENABLED=true
