OPENAI_API_KEY=replace-me
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini
# Optional comma-separated selectable models. Requires backend --enable-model-picker.
# OPENAI_MODEL is always included first.
# OPENAI_MODELS=gpt-4.1-mini,gpt-4.1,gpt-4o-mini
# YOLO mode (skip validation harness) is enabled by default; pass --disable-yolo-mode to turn off.
HOST=0.0.0.0
PORT=8787
REQUEST_TIMEOUT_MS=120000
OPENAI_CONTEXT_WINDOW=128000
# Compress run context when cumulative usage reaches this fraction (0 disables, default 0.9)
OPENAI_CONTEXT_COMPRESS_THRESHOLD=0.9
MAX_RUNS=100
MAX_ACTIVE_RUNS=5
GENERATION_RATE_LIMIT_WINDOW_MS=60000
GENERATION_RATE_LIMIT_MAX=10
# CORS_ORIGIN=https://app.example
TRUST_PROXY=false
